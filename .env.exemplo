CAM_HOST=
CAM_USER=
CAM_PASS=
CAM_RTSP_PORT=554
CAM_ONVIF_PORT=5000
# onvif1 = 1080p com audio; onvif2 = substream 640x360 sem audio (Raspberry Pi)
CAM_PATH=onvif1
# So quando CAM_PATH nao tem audio: caminho de onde puxar o audio (ex.: onvif1)
CAM_AUDIO_PATH=
CLOUDFLARE_TUNNEL_TOKEN=
APP_USER=seu_usuario
APP_PASS=troque_por_uma_senha_forte

# Push no celular pelo app ntfy. O topico funciona como senha: use um nome aleatorio.
NTFY_URL=
# Endereco publico do painel; tocar na notificacao abre o ao vivo
PUBLIC_URL=

# Custo da deteccao. Padrao: 0 (todas as threads) e 0.4s. Pi 3: 2 e 2.
DETECT_THREADS=
DETECT_INTERVAL_S=
# Fracao da cena que precisa mudar para rodar a deteccao (0 = sempre). Padrao 0.002
MOTION_MIN=

# Somente para WSL2, junto de compose.wsl.yaml.
# Descubra com: ip route | awk '/default/{print $3}'
WINDOWS_HOST=192.168.250.1
