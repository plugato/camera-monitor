CAM_HOST=
CAM_USER=
CAM_PASS=
CAM_RTSP_PORT=554
CAM_ONVIF_PORT=5000
# onvif1 = 1080p com audio; onvif2 = substream 640x360 sem audio (Raspberry Pi)
CAM_PATH=onvif1
# So quando CAM_PATH nao tem audio: caminho de onde puxar o audio (ex.: onvif1)
CAM_AUDIO_PATH=
CLOUDFLARE_TUNNEL_TOKEN=
APP_USER=seu_usuario
APP_PASS=troque_por_uma_senha_forte
# Atras do Cloudflare Access: com estes dois, vale so o login do Access e
# APP_USER/APP_PASS sao ignorados. AUD fica em Access > Applications > (app) > Overview.
CF_ACCESS_TEAM=
CF_ACCESS_AUD=

# Push no celular pelo app ntfy. O topico funciona como senha: use um nome aleatorio.
NTFY_URL=
# Endereco publico do painel; tocar na notificacao abre o ao vivo
PUBLIC_URL=

# Clipe MP4 de cada alerta: segundos antes do alerta e maximo depois dele
# (0 desliga). Padrao 5 e 30.
CLIPE_ANTES_S=
CLIPE_MAX_S=

# Confirma cada alerta no Workers AI (Gemma 4) antes do push. Vazio = push direto.
# Token so com "Workers AI Read". IA_LIMITE_DIA: maximo de consultas/dia (1500).
CF_ACCOUNT_ID=
CF_AI_TOKEN=
IA_LIMITE_DIA=

# Copia das fotos e do historico num bucket Cloudflare R2. Vazio = so no disco.
# Token em R2 > Manage API tokens, "Object Read & Write" so neste bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Com R2: dias que a foto fica no disco antes de sair (so se ja estiver no bucket)
FOTOS_LOCAL_DIAS=

# Custo da deteccao. Padrao: 0 (todas as threads) e 0.4s. Pi 3: 2 e 2.
DETECT_THREADS=
DETECT_INTERVAL_S=
# Tamanho (px, miniatura 160x90) da maior mancha de movimento para rodar a
# deteccao; ignora chuva. 0 = sempre. Padrao 40
MOTION_BLOB=

# Somente para WSL2, junto de compose.wsl.yaml.
# Descubra com: ip route | awk '/default/{print $3}'
WINDOWS_HOST=192.168.250.1

# Confianca minima para alerta de pessoa (0,25 = piso do modelo). Suba se
# houver falso alarme; o log mostra a confianca de cada pessoa vista.
# PESSOA_MIN=0.25
