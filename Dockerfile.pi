# Imagem do Raspberry Pi 3 (arm64; compose.pi.yaml: platform). Parte da base montada
# pelo base-pi.sh (Debian + OpenCV do PyPI com NEON + MediaMTX) e so copia o app:
# nenhum RUN aqui, porque o RUN arm64 morre com SIGSYS no Docker armhf do Pi.
FROM camera-monitor-base:arm64

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

WORKDIR /app
COPY server.py config.py ptz.py gunicorn.conf.py MobileNetSSD_deploy.prototxt MobileNetSSD_deploy.caffemodel ./
COPY --chmod=755 docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
